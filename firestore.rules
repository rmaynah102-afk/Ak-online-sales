rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasActiveLicense(uid) {
      let license = get(/databases/$(database)/documents/licenses/$(uid)).data;
      return request.auth != null
        && request.auth.uid == uid
        && license.status in ['trial', 'active']
        && license.expiresAt > request.time;
    }

    match /licenses/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only trusted Cloud Functions (Admin SDK) can create or extend licenses.
      allow write: if false;
    }

    match /users/{userId}/private/{document=**} {
      allow read, write: if hasActiveLicense(userId);
    }

    match /marketListings/{listingId} {
      allow read: if resource.data.status == 'published'
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if hasActiveLicense(request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 90
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.currency == 'MMK'
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == 'published'
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.price > 0;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /paymentRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.days in [30, 90, 180, 365]
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 3;
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}